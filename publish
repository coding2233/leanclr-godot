#!/bin/bash

# Linux LeanCLR publication entrypoint.
#
#   docker run --rm -v "$PWD":/src -v leanclr-cache:/cache godot-leanclr:v4.7.2-linux
#   docker run --rm ... godot-leanclr:v4.7.2-linux --project /src/samples/dotnet
#   docker run --rm ... godot-leanclr:v4.7.2-linux --ready
#
# Any other command is executed inside /src with the image toolchain on PATH.

set -euo pipefail

export DOTNET_ROOT=/usr/lib/dotnet
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export NUGET_PACKAGES="${NUGET_PACKAGES:-/cache/nuget}"
export PATH="/opt/leanclr:/usr/local/bin:/opt/godot:${DOTNET_ROOT}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

LEANCLR_ROOT=/opt/leanclr
PROJECT="${PROJECT:-/src}"
OUTPUT="${OUTPUT:-}"
WORK="${WORK:-/cache/leanclr-linux}"
TARGETS="linux"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ready)
      godot_bin="$(find /opt/godot -maxdepth 1 -type f -name 'Godot_v*_mono_linux.x86_64' -print -quit)"
      exporter="$(find "${LEANCLR_ROOT}/exporter" -maxdepth 1 -type f -name '*leanclr_m0*' -print -quit)"
      echo "godot-leanclr Linux image"
      echo "godot $("${godot_bin}" --headless --version)"
      echo "dotnet $(dotnet --version)"
      echo "exporter ${exporter}"
      echo "template ${LEANCLR_ROOT}/templates/linux/linux_release.x86_64"
      if [[ -f "${LEANCLR_ROOT}/profile.json" ]]; then
        python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); print("profile", p.get("godot_commit","?"), p.get("leanclr_commit","?"), "corelib", p.get("corelib_version","?"))' "${LEANCLR_ROOT}/profile.json"
      fi
      exit 0
      ;;
    --project)
      PROJECT="$2"; shift 2 ;;
    --output)
      OUTPUT="$2"; shift 2 ;;
    --work)
      WORK="$2"; shift 2 ;;
    --targets)
      TARGETS="$2"; shift 2 ;;
    --)
      shift; break ;;
    -*)
      echo "unknown option: $1" >&2; exit 2 ;;
    *)
      break ;;
  esac
done

if [[ "${TARGETS}" != "linux" ]]; then
  echo "this image currently supports --targets linux only (got: ${TARGETS})" >&2
  exit 2
fi

PROJECT="$(realpath "${PROJECT}")"
if [[ ! -f "${PROJECT}/project.godot" ]]; then
  echo "not a Godot project: ${PROJECT}/project.godot" >&2
  exit 2
fi
OUTPUT="${OUTPUT:-${PROJECT}/out/linux}"

if [[ $# -gt 0 ]]; then
  cd "${PROJECT}"
  exec "$@"
fi

mkdir -p "${WORK}" "${OUTPUT}"
BCL=/opt/dotnet/packs/win-x64/runtimes/win-x64/lib/net10.0
TEMPLATE="${LEANCLR_ROOT}/templates/linux/linux_release.x86_64"
EXPORTER="$(find "${LEANCLR_ROOT}/exporter" -maxdepth 1 -type f -name '*leanclr_m0*' -print -quit)"
GODOT_BIN="$(find /opt/godot -maxdepth 1 -type f -name 'Godot_v*_mono_linux.x86_64' -print -quit)"
if [[ -z "${EXPORTER}" || -z "${GODOT_BIN}" ]]; then
  echo "image is missing the private exporter or the official editor" >&2
  exit 1
fi

python3 "${LEANCLR_ROOT}/tools/prepare_linux_project.py" \
  --project "${PROJECT}" \
  --work "${WORK}/project" \
  --generic "${LEANCLR_ROOT}/managed" \
  --managed-info "${LEANCLR_ROOT}/managed/ManagedInfo.dll" \
  --profile "${LEANCLR_ROOT}/profile.json" \
  --dependencies "${LEANCLR_ROOT}/dependencies.json" \
  --bcl "${BCL}" \
  --licenses "${LEANCLR_ROOT}/licenses" \
  --out "${WORK}/payload"

python3 "${LEANCLR_ROOT}/tools/export_linux_project.py" \
  --project "${PROJECT}" \
  --work "${WORK}/export" \
  --payload "${WORK}/payload" \
  --template "${TEMPLATE}" \
  --exporter "${EXPORTER}" \
  --official-editor "${GODOT_BIN}" \
  --output "${OUTPUT}"

echo "LEANCLR_LINUX_PUBLISHED ${OUTPUT}"
